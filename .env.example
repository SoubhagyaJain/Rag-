# RAG Illustrated Agents - Environment Configuration
# Copy to .env and adjust as needed

# === Embedding Model (sentence-transformers, runs locally) ===
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Alternatives for better quality (slower / more memory):
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# === Vector Store ===
VECTORSTORE_DIR=data/vectorstore
COLLECTION_NAME=ai_agents_guidebook

# === LLM for Answer Generation + LLM-as-Judge (optional but recommended) ===
# Local via Ollama (recommended for privacy & cost)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma2:9b          # or gemma2:27b, llama3.1:8b, qwen2.5:14b, etc.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# OpenAI-compatible fallback (uncomment + set key if using)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# === Chunking (structure-aware) ===
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
TABLE_AS_SINGLE_CHUNK=true
CODE_AS_SINGLE_CHUNK=true
PRESERVE_SECTIONS=true

# === Retrieval defaults (easy to override in experiments) ===
DEFAULT_TOP_K=8
HYBRID_ALPHA=0.7          # weight for dense vs sparse (0.0 = pure BM25, 1.0 = pure dense)
USE_RERANKER=true
RERANKER_TOP_K=20         # fetch more before rerank
RERANKER_MODEL=sentence-transformers/all-MiniLM-L6-v2   # or cross-encoder/ms-marco-MiniLM-L-6-v2

# Parent-child / hierarchical retrieval
USE_PARENT_CHILD=true
PARENT_CONTEXT_CHUNKS=1   # how many sibling/parent chunks to pull for context

# === Evaluation ===
GOLDEN_DATASET_PATH=data/evaluation/golden_dataset.json
EVAL_RESULTS_DIR=artifacts/evaluation_results
LLM_AS_JUDGE=true

# === Observability / Logging ===
LOG_LEVEL=INFO
TRACE_DIR=artifacts/traces
ENABLE_STRUCTURED_LOGGING=true
